.main-scroll {
    flex-grow: 1;
}

.panel {
    padding: 8px;
    flex-grow: 1;
}

.title {
    font-size: 13px;
    -unity-font-style: bold;
    margin-bottom: 10px;
}

.toolbar {
    flex-direction: row;
    background-color: rgba(0, 0, 0, 0.1);
    border-bottom-width: 1px;
    border-bottom-color: rgba(0, 0, 0, 0.2);
    padding: 2px 4px;
    align-items: center;
    min-height: 24px;
    margin-bottom: 4px;
}

.toolbar-status {
    font-size: 11px;
    padding: 0 4px;
}

.toolbar-spacer {
    flex-grow: 1;
}

.toolbar-btn {
    padding: 2px 6px;
    font-size: 11px;
    min-height: 20px;
    margin: 0 1px;
}

.mode-row {
    flex-direction: row;
    margin: 4px 0;
}

.mode-btn {
    flex-grow: 1;
    min-height: 26px;
    margin: 0 2px;
}

.mode-btn.mode-active {
    background-color: rgba(100, 180, 220, 0.4);
    border-color: rgba(100, 180, 220, 0.8);
    border-width: 1px;
}

.status-label {
    font-size: 10px;
    color: rgba(255, 255, 255, 0.5);
    margin: 2px 0 4px 0;
}

.section {
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.1);
    border-radius: 3px;
    padding: 6px;
    margin-top: 8px;
}

.section-title {
    font-size: 12px;
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.field-row {
    flex-direction: row;
    align-items: center;
    margin: 2px 0;
}

.field-label {
    min-width: 100px;
    font-size: 11px;
}

.field-value-ro {
    flex-grow: 1;
    font-size: 11px;
    color: rgba(200, 200, 200, 0.7);
}

.mini-label {
    font-size: 10px;
    color: rgba(200, 200, 200, 0.6);
    padding: 2px 0;
}

.cell-mode-row {
    flex-direction: row;
    margin: 4px 0;
}

.button-row {
    flex-direction: row;
    margin: 2px 0;
}

.btn-half {
    flex-grow: 1;
    margin: 0 2px;
}

.btn-large {
    min-height: 32px;
    font-size: 13px;
}

.spacer-10 {
    height: 10px;
}

.spacer-6 {
    height: 6px;
}

.tab-bar {
    flex-direction: row;
    margin-top: 8px;
    margin-bottom: 2px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.1);
    padding-bottom: 2px;
}

.tab-btn {
    flex-grow: 1;
    min-height: 24px;
    margin: 0 2px;
    font-size: 11px;
}

.tab-btn.tab-active {
    background-color: rgba(100, 180, 220, 0.4);
    border-color: rgba(100, 180, 220, 0.8);
    border-width: 1px;
}
